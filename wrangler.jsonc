{
	"$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
	"name": "pp-website",
	"main": "./worker.js",
	"compatibility_date": "2026-09-30",
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pitz-pass-tickets",
			"database_id": "0be54b3a-1550-4c7f-9da6-b1a7809c3465"
		}
	]
}
